    "id": "4670996211124a13",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "format_message",
    "func": "// On extrait les données\nconst device = msg.payload.end_device_ids.device_id;\nconst time = msg.payload.received_at;\nconst sensors = msg.payload.uplink_message.decoded_payload;\n\n// On reconstruit un nouveau message propre\nmsg.payload = {\n    device: device,\n    timestamp: time,\n    temperature: sensors.temperature,\n    humidity: sensors.humidity,\n    luminosity: sensors.luminosity\n};\n\nreturn msg;",
