  {
    "id": "4670996211124a13",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "format_message",
    "func": "// On extrait les données\nconst device = msg.payload.end_device_ids.device_id;\nconst time = msg.payload.received_at;\nconst sensors = msg.payload.uplink_message.decoded_payload;\n\n// On reconstruit un nouveau message propre\nmsg.payload = {\n    device: device,\n    timestamp: time,\n    temperature: sensors.temperature,\n    humidity: sensors.humidity,\n    luminosity: sensors.luminosity\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 500,
    "wires": [["21fa1e1d259a9b50", "b332ae6929e65246", "6cf5f443c7572218"]]
  },
  {
    "id": "dc079acb2df6d28d",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "prepare downlink",
    "func": "// Exemple : On veut envoyer \"1\" pour allumer un ventilo, \"0\" pour éteindre\n// TTN demande du Base64. \"1\" en Base64 est \"MQ==\"\nconst command = (msg.payload.temperature > 5) ? \"AQ==\" : \"AA==\";\n\nmsg.payload = {\n    \"downlinks\": [{\n        \"f_port\": 15,            // Port utilisé par ton code ESP32\n        \"frm_payload\": command,  // La commande en Base64\n        \"priority\": \"NORMAL\"\n    }]\n};\n\n// Très important : Le topic MQTT pour le Downlink TTN est spécifique\n// Remplace par tes vrais IDs\nconst appID = \"ynov-test-m1\";\nconst devID = \"ra3172-capteur-3\";\nmsg.topic = `v3/${appID}@ttn/devices/${devID}/down/push`;\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 870,
    "y": 500,
    "wires": [["4263297b9ae7e409"]]
  },
